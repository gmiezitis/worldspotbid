# Use Stripe test-mode values until the complete flow has been reviewed.
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PUBLIC_APP_ORIGIN=https://replace-with-your-site-hostname.example

# Optional backend tuning. Defaults are safe for one small Render instance.
PORT=3001
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_LIFETIME_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
